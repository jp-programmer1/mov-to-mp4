{
  "name": "mov-to-mp4",
  "version": "1.0.0",
  "description": "Conversor local de video .mov a .mp4 (Electron + React + FFmpeg)",
  "author": "jpprogrammer1 | https://www.linkedin.com/in/juan-pablo-f-23a940180",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux",
    "preview": "vite preview"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.emir.movtomp4",
    "npmRebuild": false,
    "productName": "MOV to MP4",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "target": "dmg",
      "artifactName": "MOV-to-MP4-mac-${arch}.${ext}",
      "category": "public.app-category.video",
      "hardenedRuntime": false
    },
    "win": {
      "artifactName": "MOV-to-MP4-Setup-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MOV to MP4"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}